enum IntegrationProvider {
  SHOPIFY
  META
  TIKTOK
}

enum ConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISCONNECTED
  UNINSTALLED
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

enum WebhookStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model ShopifyConnection {
  id                            String           @id @default(uuid()) @db.Uuid
  storeId                       String           @unique @db.Uuid
  status                        ConnectionStatus @default(ACTIVE)
  accessTokenCiphertext         String
  accessTokenExpiresAt          DateTime?
  refreshTokenCiphertext        String?
  refreshTokenExpiresAt         DateTime?
  scopes                        String[]         @default([])
  apiVersion                    String
  installedAt                   DateTime         @default(now())
  uninstalledAt                 DateTime?
  lastSyncedAt                  DateTime?
  reconciliationIntervalMinutes Int              @default(1440)
  lastReconciledAt              DateTime?
  nextReconciliationAt          DateTime?
  reconciliationClaimedAt       DateTime?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  store             Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  syncRuns          SyncRun[]
  webhookDeliveries WebhookDelivery[]

  @@index([status, nextReconciliationAt])
  @@index([reconciliationClaimedAt])
}

model MetaConnection {
  id                    String           @id @default(uuid()) @db.Uuid
  storeId               String           @unique @db.Uuid
  status                ConnectionStatus @default(ACTIVE)
  metaUserId            String?
  metaBusinessId        String?
  selectedAdAccountIds  String[]         @default([])
  selectedCatalogIds    String[]         @default([])
  accessTokenCiphertext String
  tokenExpiresAt        DateTime?
  scopes                String[]         @default([])
  apiVersion             String
  lastSyncedAt           DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  store             Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  adAccounts        MetaAdAccount[]
  catalogs          MetaProductCatalog[]
  syncRuns          SyncRun[]
  webhookDeliveries WebhookDelivery[]
}

model TikTokConnection {
  id                     String           @id @default(uuid()) @db.Uuid
  storeId                String           @unique @db.Uuid
  status                 ConnectionStatus @default(ACTIVE)
  openId                 String?
  businessCenterId       String?
  selectedAdvertiserIds  String[]         @default([])
  selectedCatalogIds     String[]         @default([])
  accessTokenCiphertext  String
  accessTokenExpiresAt   DateTime?
  refreshTokenCiphertext String?
  refreshTokenExpiresAt  DateTime?
  scopes                 String[]         @default([])
  apiVersion             String
  lastSyncedAt           DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  store             Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  advertisers       TikTokAdvertiser[]
  catalogs          TikTokCatalog[]
  syncRuns          SyncRun[]
  webhookDeliveries WebhookDelivery[]
}

model SyncRun {
  id                   String              @id @default(uuid()) @db.Uuid
  provider             IntegrationProvider
  shopifyConnectionId  String?             @db.Uuid
  metaConnectionId     String?             @db.Uuid
  tiktokConnectionId   String?             @db.Uuid
  resourceType         String
  mode                 String?
  apiVersion           String
  status               SyncStatus          @default(PENDING)
  providerOperationId  String?
  cursor               String?
  recordsRead          Int                 @default(0)
  recordsWritten       Int                 @default(0)
  startedAt            DateTime?
  finishedAt           DateTime?
  lastError            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  shopifyConnection ShopifyConnection? @relation(fields: [shopifyConnectionId], references: [id], onDelete: SetNull)
  metaConnection    MetaConnection?    @relation(fields: [metaConnectionId], references: [id], onDelete: SetNull)
  tiktokConnection  TikTokConnection?  @relation(fields: [tiktokConnectionId], references: [id], onDelete: SetNull)
  payloads          ExternalPayload[]

  @@index([provider, resourceType, createdAt])
  @@index([provider, resourceType, status, createdAt])
  @@index([providerOperationId])
  @@index([shopifyConnectionId, createdAt])
  @@index([metaConnectionId, createdAt])
  @@index([tiktokConnectionId, createdAt])
}

model WebhookDelivery {
  id                   String              @id @default(uuid()) @db.Uuid
  provider             IntegrationProvider
  externalDeliveryId   String
  shopifyConnectionId  String?             @db.Uuid
  metaConnectionId     String?             @db.Uuid
  tiktokConnectionId   String?             @db.Uuid
  topic                String
  apiVersion           String?
  triggeredAt          DateTime?
  receivedAt           DateTime            @default(now())
  processingStartedAt  DateTime?
  nextAttemptAt        DateTime?
  processedAt          DateTime?
  status               WebhookStatus       @default(RECEIVED)
  attempts             Int                 @default(0)
  lastError            String?
  payload              Json
  updatedAt            DateTime             @updatedAt

  shopifyConnection ShopifyConnection?  @relation(fields: [shopifyConnectionId], references: [id], onDelete: SetNull)
  metaConnection    MetaConnection?     @relation(fields: [metaConnectionId], references: [id], onDelete: SetNull)
  tiktokConnection  TikTokConnection?   @relation(fields: [tiktokConnectionId], references: [id], onDelete: SetNull)
  payloads          ExternalPayload[]
  shopifyDataRequest ShopifyDataRequest?

  @@unique([provider, externalDeliveryId])
  @@index([provider, topic, receivedAt])
  @@index([status, nextAttemptAt, receivedAt])
  @@index([status, processingStartedAt])
  @@index([tiktokConnectionId, receivedAt])
}

model ShopifyDataRequest {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @db.Uuid
  webhookDeliveryId String   @unique @db.Uuid
  requestedOrderIds String[] @default([])
  exportJson        Json
  completedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  webhookDelivery WebhookDelivery @relation(fields: [webhookDeliveryId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

model ExternalPayload {
  id                String              @id @default(uuid()) @db.Uuid
  provider          IntegrationProvider
  resourceType      String
  externalId        String?
  apiVersion        String
  payload           Json
  receivedAt        DateTime            @default(now())
  syncRunId         String?             @db.Uuid
  webhookDeliveryId String?             @db.Uuid

  syncRun         SyncRun?         @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  webhookDelivery WebhookDelivery? @relation(fields: [webhookDeliveryId], references: [id], onDelete: SetNull)

  @@index([provider, resourceType, receivedAt])
  @@index([externalId])
}
