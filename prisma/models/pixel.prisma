enum StorefrontEventName {
  PAGE_VIEW
  PRODUCT_VIEW
  COLLECTION_VIEW
  SEARCH
  ADD_TO_CART
  REMOVE_FROM_CART
  BEGIN_CHECKOUT
  CHECKOUT_PROGRESS
  CHECKOUT_COMPLETED
}

enum StorefrontConsentState {
  UNKNOWN
  GRANTED
  DENIED
  NOT_REQUIRED
}

enum PixelInstallationStatus {
  ACTIVE
  ERROR
  DISABLED
}

enum StorefrontJourneySource {
  META
  GOOGLE
  TIKTOK
  UTM
  REFERRER
  DIRECT
  UNKNOWN
}

enum StorefrontResolutionStatus {
  NONE
  EXACT
  PARTIAL
  UNRESOLVED
  CONFLICT
}

enum StorefrontOrderLinkStatus {
  NONE
  PENDING
  LINKED
}

enum StorefrontBehaviorDimension {
  STORE
  PRODUCT
  COLLECTION
  LANDING_PAGE
}

model PixelInstallation {
  id                   String                  @id @default(uuid()) @db.Uuid
  storeId              String                  @unique @db.Uuid
  collectorTokenHash   String                  @db.VarChar(64)
  collectorTokenPrefix String                  @db.VarChar(12)
  shopifyWebPixelId    String?                 @unique @db.VarChar(128)
  status               PixelInstallationStatus @default(ERROR)
  installedAt          DateTime?
  lastEventAt          DateTime?
  lastError            String?                 @db.Text
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lastEventAt])
}

model StorefrontEvent {
  id                     String                   @id @default(uuid()) @db.Uuid
  storeId                String                   @db.Uuid
  eventId                String                   @db.VarChar(128)
  eventVersion           Int                      @default(1)
  eventName              StorefrontEventName
  eventAt                DateTime
  receivedAt             DateTime                 @default(now())
  anonymousVisitorId     String?                  @db.VarChar(128)
  sessionId              String?                  @db.VarChar(128)
  consentState           StorefrontConsentState
  pageUrl                String?                  @db.Text
  referrerUrl            String?                  @db.Text
  landingPageUrl         String?                  @db.Text
  productExternalId      String?                  @db.VarChar(128)
  variantExternalId      String?                  @db.VarChar(128)
  collectionExternalId   String?                  @db.VarChar(128)
  quantity               Int?
  shopifyCheckoutToken   String?                  @db.VarChar(255)
  shopifyOrderExternalId String?                  @db.VarChar(128)
  utmSource              String?                  @db.VarChar(255)
  utmMedium              String?                  @db.VarChar(255)
  utmCampaign            String?                  @db.VarChar(255)
  utmContent             String?                  @db.VarChar(255)
  utmTerm                String?                  @db.VarChar(255)
  metaClickId            String?                  @db.VarChar(512)
  googleClickId          String?                  @db.VarChar(512)
  tiktokClickId          String?                  @db.VarChar(512)
  metaCampaignExternalId String?                  @db.VarChar(128)
  metaAdSetExternalId    String?                  @db.VarChar(128)
  metaAdExternalId       String?                  @db.VarChar(128)
  retentionExpiresAt     DateTime

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, eventId])
  @@index([storeId, eventAt])
  @@index([storeId, eventName, eventAt])
  @@index([storeId, anonymousVisitorId, eventAt])
  @@index([storeId, sessionId, eventAt])
  @@index([storeId, metaAdExternalId, eventAt])
  @@index([storeId, shopifyOrderExternalId])
  @@index([retentionExpiresAt])
}

model StorefrontSession {
  id                       String                    @id @default(uuid()) @db.Uuid
  storeId                  String                    @db.Uuid
  browserSessionId         String                    @db.VarChar(128)
  anonymousVisitorId       String?                   @db.VarChar(128)
  startedAt                DateTime
  endedAt                  DateTime
  lastSourceReceivedAt     DateTime
  eventCount               Int
  pageViewCount            Int                       @default(0)
  productViewCount         Int                       @default(0)
  collectionViewCount      Int                       @default(0)
  searchCount              Int                       @default(0)
  addToCartCount           Int                       @default(0)
  removeFromCartCount      Int                       @default(0)
  checkoutProgressCount    Int                       @default(0)
  checkoutStartedAt        DateTime?
  checkoutCompletedAt      DateTime?
  shopifyCheckoutToken     String?                   @db.VarChar(255)
  shopifyOrderExternalId   String?                   @db.VarChar(128)
  orderId                  String?                   @db.Uuid
  orderLinkStatus          StorefrontOrderLinkStatus @default(NONE)
  landingPageUrl           String?                   @db.Text
  initialReferrerUrl       String?                   @db.Text
  dataQualityFlags         String[]                  @default([])
  retentionExpiresAt       DateTime
  materializedAt           DateTime                  @default(now())
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  store       Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  touches     StorefrontSessionTouch[]
  products    StorefrontSessionProduct[]
  collections StorefrontSessionCollection[]

  @@unique([storeId, browserSessionId])
  @@index([storeId, startedAt])
  @@index([storeId, anonymousVisitorId, startedAt])
  @@index([storeId, orderLinkStatus, checkoutCompletedAt])
  @@index([orderId])
  @@index([retentionExpiresAt])
}

model StorefrontSessionTouch {
  id                     String                     @id @default(uuid()) @db.Uuid
  sessionId              String                     @db.Uuid
  ordinal                Int
  eventAt                DateTime
  source                 StorefrontJourneySource
  landingPageUrl         String?                    @db.Text
  referrerUrl            String?                    @db.Text
  utmSource              String?                    @db.VarChar(255)
  utmMedium              String?                    @db.VarChar(255)
  utmCampaign            String?                    @db.VarChar(255)
  utmContent             String?                    @db.VarChar(255)
  utmTerm                String?                    @db.VarChar(255)
  metaClickId            String?                    @db.VarChar(512)
  googleClickId          String?                    @db.VarChar(512)
  tiktokClickId          String?                    @db.VarChar(512)
  metaCampaignExternalId String?                    @db.VarChar(128)
  metaAdSetExternalId    String?                    @db.VarChar(128)
  metaAdExternalId       String?                    @db.VarChar(128)
  metaCampaignId         String?                    @db.Uuid
  metaAdSetId            String?                    @db.Uuid
  metaAdId               String?                    @db.Uuid
  metaResolutionStatus   StorefrontResolutionStatus @default(NONE)
  createdAt              DateTime                   @default(now())

  session StorefrontSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, ordinal])
  @@index([metaAdId, eventAt])
  @@index([metaAdSetId, eventAt])
  @@index([metaCampaignId, eventAt])
  @@index([source, eventAt])
}

model StorefrontSessionProduct {
  id                       String                     @id @default(uuid()) @db.Uuid
  sessionId                String                     @db.Uuid
  identityKey              String                     @db.VarChar(300)
  shopifyProductExternalId String?                    @db.VarChar(128)
  shopifyVariantExternalId String?                    @db.VarChar(128)
  productId                String?                    @db.Uuid
  variantId                String?                    @db.Uuid
  resolutionStatus         StorefrontResolutionStatus @default(NONE)
  viewCount                Int                        @default(0)
  addToCartCount           Int                        @default(0)
  removeFromCartCount      Int                        @default(0)
  firstSeenAt              DateTime
  lastSeenAt               DateTime
  createdAt                DateTime                   @default(now())

  session StorefrontSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, identityKey])
  @@index([productId, firstSeenAt])
  @@index([variantId, firstSeenAt])
}

model StorefrontSessionCollection {
  id                          String                     @id @default(uuid()) @db.Uuid
  sessionId                   String                     @db.Uuid
  shopifyCollectionExternalId String                     @db.VarChar(128)
  collectionId                String?                    @db.Uuid
  resolutionStatus            StorefrontResolutionStatus @default(NONE)
  viewCount                   Int                        @default(0)
  firstSeenAt                 DateTime
  lastSeenAt                  DateTime
  createdAt                   DateTime                   @default(now())

  session StorefrontSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, shopifyCollectionExternalId])
  @@index([collectionId, firstSeenAt])
}

model StorefrontBehaviorDaily {
  id                               String                     @id @default(uuid()) @db.Uuid
  storeId                          String                     @db.Uuid
  bucketDate                       DateTime                   @db.Date
  dimension                        StorefrontBehaviorDimension
  dimensionKey                     String                     @db.VarChar(320)
  productId                        String?                    @db.Uuid
  variantId                        String?                    @db.Uuid
  collectionId                     String?                    @db.Uuid
  productExternalId                String?                    @db.VarChar(128)
  variantExternalId                String?                    @db.VarChar(128)
  collectionExternalId             String?                    @db.VarChar(128)
  landingPageHash                  String?                    @db.VarChar(64)
  landingPageUrl                   String?                    @db.Text
  sessionCount                     Int                        @default(0)
  pageViewCount                    Int                        @default(0)
  productViewCount                 Int                        @default(0)
  collectionViewCount              Int                        @default(0)
  searchCount                      Int                        @default(0)
  addToCartCount                   Int                        @default(0)
  removeFromCartCount              Int                        @default(0)
  productViewSessionCount          Int                        @default(0)
  collectionViewSessionCount       Int                        @default(0)
  searchSessionCount               Int                        @default(0)
  addToCartSessionCount            Int                        @default(0)
  checkoutStartSessionCount        Int                        @default(0)
  checkoutCompletedSessionCount    Int                        @default(0)
  linkedPurchaseSessionCount       Int                        @default(0)
  conversionDelayMsTotal           BigInt                     @default(0)
  conversionDelayCount             Int                        @default(0)
  exactResolutionSessionCount      Int                        @default(0)
  partialResolutionSessionCount    Int                        @default(0)
  unresolvedResolutionSessionCount Int                        @default(0)
  conflictResolutionSessionCount   Int                        @default(0)
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, bucketDate, dimension, dimensionKey], map: "StorefrontBehaviorDaily_store_date_dim_key")
  @@index([storeId, bucketDate, dimension], map: "StorefrontBehaviorDaily_store_date_dim_idx")
  @@index([storeId, productId, bucketDate], map: "StorefrontBehaviorDaily_product_date_idx")
  @@index([storeId, collectionId, bucketDate], map: "StorefrontBehaviorDaily_collection_date_idx")
  @@index([storeId, landingPageHash, bucketDate], map: "StorefrontBehaviorDaily_landing_date_idx")
}

model StorefrontBehaviorRollupState {
  id                          String   @id @default(uuid()) @db.Uuid
  storeId                     String   @unique(map: "StorefrontBehaviorRollupState_store_key") @db.Uuid
  rolledThroughMaterializedAt DateTime?
  lastRolledUpAt              DateTime?
  lastError                   String?  @db.Text
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
