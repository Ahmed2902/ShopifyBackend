enum StoreRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuthEmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  SUPERSEDED
  DEAD
}

enum InventoryIntelligenceMode {
  DISABLED
  TRUSTED
  UNRELIABLE
}

enum BillingPlan {
  ESSENTIALS
  PRO
}

enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingProvider {
  INTERNAL
  SHOPIFY
}

enum BillingAdProvider {
  META
  TIKTOK
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  name            String?
  passwordHash    String?
  googleId        String?  @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     StoreMembership[]
  sessions        RefreshSession[]
  authTokens      AuthToken[]
  emailDeliveries AuthEmailDelivery[]

  @@index([createdAt])
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([expiresAt])
}

model AuthEmailDelivery {
  id                  String                  @id @default(uuid()) @db.Uuid
  userId              String                  @db.Uuid
  type                AuthTokenType
  recipient           String
  tokenHash           String                  @unique
  tokenCiphertext     String?
  status              AuthEmailDeliveryStatus @default(PENDING)
  attempts            Int                     @default(0)
  nextAttemptAt       DateTime                @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  lastError           String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([processingStartedAt])
  @@index([userId, type, createdAt])
}

model StoreMembership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  storeId   String    @db.Uuid
  role      StoreRole @default(MEMBER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId, role])
}

model StoreSubscription {
  id                       String             @id @default(uuid()) @db.Uuid
  storeId                  String             @unique @db.Uuid
  selectedPlan             BillingPlan        @default(ESSENTIALS)
  status                   BillingStatus      @default(TRIALING)
  provider                 BillingProvider    @default(INTERNAL)
  essentialsAdProvider     BillingAdProvider?
  trialStartedAt           DateTime
  trialEndsAt              DateTime
  currentPeriodEndsAt      DateTime?
  canceledAt               DateTime?
  cancelAtEndOfCycle       Boolean            @default(false)
  shopifyAppSubscriptionId String?            @unique
  shopifyPlanHandle        String?
  lastVerifiedAt           DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status, trialEndsAt])
  @@index([provider, status])
}

model Store {
  id                           String                    @id @default(uuid()) @db.Uuid
  shopifyShopId                String                    @unique
  name                         String
  myshopifyDomain              String                    @unique
  currencyCode                 String
  ianaTimezone                 String
  primaryDomainHost            String?
  primaryDomainUrl             String?
  enabledPresentmentCurrencies String[]                  @default([])
  shopifyCreatedAt             DateTime?
  inventoryIntelligenceMode    InventoryIntelligenceMode @default(DISABLED)
  inventoryReviewedAt          DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  subscription                    StoreSubscription?
  memberships                     StoreMembership[]
  shopifyConnection               ShopifyConnection?
  metaConnection                  MetaConnection?
  tiktokConnection                TikTokConnection?
  pixelInstallation               PixelInstallation?
  shopifyDataRequests             ShopifyDataRequest[]
  shopifyOrderRedactions          ShopifyOrderRedaction[]
  metaAdAccounts                  MetaAdAccount[]
  metaCatalogs                    MetaProductCatalog[]
  tiktokAdvertisers               TikTokAdvertiser[]
  tiktokCatalogs                  TikTokCatalog[]
  products                        Product[]
  variants                        ProductVariant[]
  collections                     Collection[]
  inventoryItems                  InventoryItem[]
  locations                       Location[]
  orders                          Order[]
  restocks                        Restock[]
  storefrontEvents                StorefrontEvent[]
  storefrontSessionRepairs        StorefrontSessionRepair[]
  storefrontSessions              StorefrontSession[]
  storefrontBehaviorDaily         StorefrontBehaviorDaily[]
  storefrontBehaviorRollup        StorefrontBehaviorRollupState?
  storefrontAttributionDaily      StorefrontAttributionDaily[]
  storefrontAttributionPaths      StorefrontAttributionPathDaily[]
  storefrontMetaTargetEvidence    StorefrontMetaTargetEvidenceDaily[]
  storefrontAttributionRollup     StorefrontAttributionRollupState?
}
