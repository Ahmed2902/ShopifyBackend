enum StoreRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum InventoryIntelligenceMode {
  DISABLED
  TRUSTED
  UNRELIABLE
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  name            String?
  passwordHash    String?
  googleId        String?  @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships StoreMembership[]
  sessions    RefreshSession[]
  authTokens  AuthToken[]

  @@index([createdAt])
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([expiresAt])
}

model StoreMembership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  storeId   String    @db.Uuid
  role      StoreRole @default(MEMBER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId, role])
}

model Store {
  id                           String                    @id @default(uuid()) @db.Uuid
  shopifyShopId                String                    @unique
  name                         String
  myshopifyDomain              String                    @unique
  currencyCode                 String
  ianaTimezone                 String
  primaryDomainHost            String?
  primaryDomainUrl             String?
  enabledPresentmentCurrencies String[]                  @default([])
  shopifyCreatedAt             DateTime?
  inventoryIntelligenceMode    InventoryIntelligenceMode @default(DISABLED)
  inventoryReviewedAt          DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  memberships                 StoreMembership[]
  shopifyConnection           ShopifyConnection?
  metaConnection              MetaConnection?
  tiktokConnection            TikTokConnection?
  pixelInstallation           PixelInstallation?
  metaAdAccounts              MetaAdAccount[]
  metaCatalogs                MetaProductCatalog[]
  tiktokAdvertisers           TikTokAdvertiser[]
  tiktokCatalogs              TikTokCatalog[]
  products                    Product[]
  variants                    ProductVariant[]
  collections                 Collection[]
  inventoryItems              InventoryItem[]
  locations                   Location[]
  orders                      Order[]
  restocks                    Restock[]
  storefrontEvents            StorefrontEvent[]
  storefrontSessions          StorefrontSession[]
  storefrontBehaviorDaily     StorefrontBehaviorDaily[]
  storefrontBehaviorRollup    StorefrontBehaviorRollupState?
}
