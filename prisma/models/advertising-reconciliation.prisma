enum AdvertisingReconciliationStatus {
  IDLE
  RUNNING
  BACKOFF
  SUSPENDED
}

model AdvertisingReconciliationState {
  id                     String                           @id @default(uuid()) @db.Uuid
  storeId                String                           @db.Uuid
  provider               AdvertisingProvider
  status                 AdvertisingReconciliationStatus @default(IDLE)
  nextDailyAt            DateTime?
  nextCatalogAt          DateTime?
  manualRequestedAt      DateTime?
  urgentAt               DateTime?
  urgentKinds            String[]                         @default([])
  claimedAt              DateTime?
  claimToken             String?
  lastStartedAt          DateTime?
  lastSucceededAt        DateTime?
  lastCatalogSucceededAt DateTime?
  failureCount           Int                              @default(0)
  retryAt                DateTime?
  suspendedReason        String?
  lastError              String?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([status, nextDailyAt])
  @@index([status, retryAt])
  @@index([manualRequestedAt])
  @@index([urgentAt])
  @@index([claimedAt])
}
