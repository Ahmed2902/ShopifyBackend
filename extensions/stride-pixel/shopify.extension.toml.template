# Copy these settings into the Shopify CLI-generated web pixel extension config.
# Keep the real `uid` generated by Shopify CLI. Do not deploy this template directly.

api_version = "2026-07"
type = "web_pixel_extension"
name = "Stride Pixel"
uid = "REPLACE_WITH_SHOPIFY_CLI_GENERATED_UID"
runtime_context = "strict"

[customer_privacy]
analytics = true
marketing = false
preferences = false
sale_of_data = "disabled"

[settings]
type = "object"

[settings.fields.collectorUrl]
name = "Collector URL"
description = "Stride first-party storefront event collector endpoint"
type = "single_line_text_field"
validations = [{ name = "min", value = "1" }]

[settings.fields.installationId]
name = "Installation ID"
description = "Opaque Stride installation identifier"
type = "single_line_text_field"
validations = [{ name = "min", value = "1" }]

[settings.fields.collectorToken]
name = "Collector Token"
description = "Opaque per-installation collector credential"
type = "single_line_text_field"
validations = [{ name = "min", value = "40" }]
