# Copy to backend.env on the server, chmod 600. Raw Compose env file: no quotes.
NODE_ENV=production
LEGACY_MERCHANT_AUTH_ENABLED=false
APP_URL=https://api.metrico.live
FRONTEND_URL=https://app.metrico.live
CORS_ORIGIN=https://app.metrico.live
PORT=3001
LOG_LEVEL=info
DATABASE_URL=REPLACE_WITH_SUPABASE_TLS_SESSION_OR_DIRECT_URL
# Optional separate direct/session URL for Prisma migration CLI.
# MIGRATION_DATABASE_URL=...
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MS=300000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_REST_URL=REPLACE_WITH_HTTPS_REST_ENDPOINT
REDIS_REST_TOKEN=REPLACE_WITH_REDIS_REST_TOKEN
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_SECRET
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_BASE64_32_BYTE_KEY
SHOPIFY_CLIENT_ID=REPLACE_WITH_METRICO_CLIENT_ID
SHOPIFY_CLIENT_SECRET=REPLACE_WITH_METRICO_CLIENT_SECRET
SHOPIFY_STATE_SECRET=REPLACE_WITH_RANDOM_SECRET
SHOPIFY_SCOPES=read_products,write_products,read_inventory,read_locations,read_orders,read_all_orders,read_pixels,write_pixels,read_customer_events
SHOPIFY_REDIRECT_URI=https://app.metrico.live/api/shopify/callback
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_URL=https://app.metrico.live/app/overview
SHOPIFY_APP_PRICING_ENABLED=true
SHOPIFY_PARTNER_ORG_ID=REPLACE_WITH_ORG_ID
SHOPIFY_PARTNER_API_ACCESS_TOKEN=REPLACE_WITH_MANAGE_APPS_PARTNER_TOKEN
SHOPIFY_PARTNER_APP_ID=REPLACE_WITH_GID_SHOPIFY_APP_ID
SHOPIFY_APP_HANDLE=REPLACE_WITH_HOSTED_PRICING_APP_HANDLE
SHOPIFY_ESSENTIALS_PLAN_HANDLE=REPLACE_WITH_ESSENTIALS_HANDLE
SHOPIFY_PRO_PLAN_HANDLE=REPLACE_WITH_PRO_HANDLE
SHOPIFY_PRIVACY_POLICY_URL=https://metrico.live/privacy
SHOPIFY_TERMS_URL=https://metrico.live/terms
SHOPIFY_SUPPORT_EMAIL=REPLACE_WITH_MONITORED_EMAIL
SHOPIFY_REVIEW_CONTACT_EMAIL=REPLACE_WITH_MONITORED_EMAIL
SHOPIFY_EMERGENCY_CONTACT_EMAIL=REPLACE_WITH_MONITORED_EMAIL
PIXEL_COLLECTOR_URL=https://api.metrico.live/v1/pixel/events
PIXEL_RAW_EVENT_RETENTION_DAYS=90
SHOPIFY_ENHANCED_MATCHING_APPROVED=false
# Keep matching disabled until actual protected-data approval and privacy controls are verified.
# Retain only fields approved for this app and advertising purpose. Name/address/client_ip are excluded.
SHOPIFY_ENHANCED_MATCHING_FIELDS=email,phone,customer_id
META_APP_ID=REPLACE_WITH_EXISTING_META_APP_ID
META_APP_SECRET=REPLACE_WITH_EXISTING_META_APP_SECRET
META_STATE_SECRET=REPLACE_WITH_RANDOM_SECRET
META_SCOPES=ads_read
META_API_VERSION=v26.0
# Optional providers: uncomment the whole credential group when ready.
# TIKTOK_APP_ID=7683136035535863828
# TIKTOK_APP_SECRET=...
# TIKTOK_STATE_SECRET=...
TIKTOK_EVENTS_API_ENABLED=false
# GOOGLE_ADS_CLIENT_ID=...
# GOOGLE_ADS_CLIENT_SECRET=...
# GOOGLE_ADS_STATE_SECRET=...
GOOGLE_ADS_API_VERSION=v25
# Do not set GOOGLE_ADS_DEVELOPER_TOKEN; it was retired.

# Optional Sentry production error reporting. DSN is an ingestion address, not an account token.
# Remove SENTRY_DSN entirely to disable. Do not leave an empty value in this raw env file.
# SENTRY_DSN=https://PUBLIC_KEY@SENTRY_INGEST_HOST/PROJECT_ID
# SENTRY_RELEASE=backend-GIT_COMMIT_SHA
# SENTRY_WORKER_MONITOR_SLUG=metrico-worker
