# Copy to backup.env, chmod 600. Use values from Supabase Connect (session/direct).
# No quotes. Password can contain literal characters; it is not embedded in a URL.
PGHOST=REPLACE_WITH_DATABASE_HOST
PGPORT=5432
PGDATABASE=postgres
PGUSER=REPLACE_WITH_OWNER_OR_BACKEND_BACKUP_USER
PGPASSWORD=REPLACE_WITH_DATABASE_PASSWORD
PGSSLMODE=require
PGCONNECT_TIMEOUT=15
