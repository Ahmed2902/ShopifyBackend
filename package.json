{
  "name": "shopify-inventory-intelligence-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "predev:api": "prisma generate",
    "dev:api": "tsx watch src/api.ts",
    "predev:worker": "prisma generate",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "start": "node dist/api.js",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "start:combined": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:intelligence-scenarios": "vitest run tests/modules/intelligence/intelligence.scenario-matrix.test.ts tests/modules/intelligence/intelligence.service.scenarios.test.ts",
    "dev:intelligence-scenarios": "tsx scripts/intelligence-scenario-lab.ts",
    "dev:meta-fixtures": "tsx scripts/meta-fixture-seed.ts",
    "dev:meta-fixtures:write": "tsx scripts/meta-fixture-seed.ts --write",
    "dev:meta-fixtures:cleanup": "tsx scripts/meta-fixture-seed.ts --cleanup",
    "perf:analytics": "node scripts/benchmark-analytics.mjs",
    "smoke:v1-release": "node scripts/v1-release-smoke.mjs",
    "smoke:v1-release:check": "node --check scripts/v1-release-smoke.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:check": "prisma migrate diff --exit-code --from-config-datasource --to-schema prisma",
    "ci": "npm run prisma:validate && npm run lint && npm run typecheck && npm run test && npm run smoke:v1-release:check"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prisma": "^7.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
