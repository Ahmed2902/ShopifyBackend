NODE_ENV=development
PORT=3001
# Canonical public backend origin. On Vercel, production can also infer this from VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3001
# Canonical public frontend origin used for OAuth success redirects and auth-email links.
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopify_intelligence
# Prisma 7 uses node-postgres pooling. Defaults preserve a bounded 10-connection process pool while
# keeping idle connections warm for 5 minutes instead of pg's 10-second default.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=300000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# Optional separate CORS origin. Defaults to FRONTEND_URL when omitted.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Log every request's total/DB timing. Keep false in normal production unless actively profiling;
# requests slower than SLOW_REQUEST_THRESHOLD_MS are always logged as warnings.
LOG_REQUEST_PERFORMANCE=false
SLOW_REQUEST_THRESHOLD_MS=1000
REDIS_REST_URL=https://your-redis-rest-endpoint
REDIS_REST_TOKEN=replace-with-redis-rest-token
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=shopify-intelligence-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Optional local/dev override. Production derives this from APP_URL.
# GOOGLE_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback
# Optional local/dev override. Production returns to FRONTEND_URL/auth/callback.
# GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:3000/auth/callback
# Google Ads OAuth is separate from normal Stride Google login. Enable only with a Google Ads
# developer token and OAuth client authorized for the adwords scope.
# GOOGLE_ADS_CLIENT_ID=replace-with-google-ads-oauth-client-id
# GOOGLE_ADS_CLIENT_SECRET=replace-with-google-ads-oauth-client-secret
# GOOGLE_ADS_DEVELOPER_TOKEN=replace-with-google-ads-developer-token
# GOOGLE_ADS_STATE_SECRET=replace-with-at-least-32-random-characters
# Optional local/dev override. Production derives this from APP_URL.
# GOOGLE_ADS_REDIRECT_URI=http://localhost:3001/v1/integrations/google-ads/callback
GOOGLE_ADS_API_VERSION=v25
# Required for password-account verification and password recovery in production.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM="Stride <no-reply@your-verified-domain.example>"
# Optional overrides. When omitted they default to FRONTEND_URL + the routes below.
# EMAIL_VERIFICATION_URL=http://localhost:3000/auth/verify-email
# PASSWORD_RESET_URL=http://localhost:3000/auth/reset-password
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
# write_products is required only for explicit Owner/Admin collection creation from Stride.
SHOPIFY_SCOPES=read_products,write_products,read_inventory,read_locations,read_orders,write_pixels,read_pixels,read_customer_events
# Exact OAuth callback URL configured in Shopify's active app version.
# Local: http://localhost:3000/api/shopify/callback
# Production: https://<your-frontend-host>/api/shopify/callback
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/shopify/callback
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STATE_SECRET=replace-with-at-least-32-random-characters
# Pre-launch default: internal 14-day Pro-equivalent trial. Enable only after Shopify App Pricing
# plans are configured for the public app in Partner Dashboard.
SHOPIFY_APP_PRICING_ENABLED=false
# Required only when SHOPIFY_APP_PRICING_ENABLED=true.
# Partner API client must have Manage apps permission.
# SHOPIFY_PARTNER_ORG_ID=1234567
# SHOPIFY_PARTNER_API_ACCESS_TOKEN=replace-with-partner-api-client-token
# SHOPIFY_PARTNER_APP_ID=gid://shopify/App/123456789
SHOPIFY_PARTNER_API_VERSION=2026-07
# App handle from Shopify app configuration / hosted pricing URL.
# SHOPIFY_APP_HANDLE=stride
# Exact Shopify App Pricing item/plan handles configured in Partner Dashboard.
# SHOPIFY_ESSENTIALS_PLAN_HANDLE=essentials
# SHOPIFY_PRO_PLAN_HANDLE=pro
SHOPIFY_BILLING_VERIFY_TTL_SECONDS=300
# Optional override. Defaults to APP_URL + /v1/pixel/events.
# PIXEL_COLLECTOR_URL=https://api.example.com/v1/pixel/events
PIXEL_RAW_EVENT_RETENTION_DAYS=90
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_SCOPES=ads_read
# Optional local/dev override. Production derives this from APP_URL.
# META_REDIRECT_URI=http://localhost:3001/v1/integrations/meta/callback
META_API_VERSION=v26.0
META_STATE_SECRET=replace-with-at-least-32-random-characters
# Initial historical window for a newly selected account. Refreshes use the smaller rolling window below.
META_INITIAL_LOOKBACK_DAYS=365
META_REFRESH_LOOKBACK_DAYS=35
# Optional local-only database fixture tooling. These values must identify a real connected store/account.
# The confirmation value must exactly match the target account before --write or --cleanup runs.
# META_FIXTURE_STORE_ID=00000000-0000-0000-0000-000000000000
# META_FIXTURE_AD_ACCOUNT_ID=act_123456789
# META_FIXTURE_CONFIRM_AD_ACCOUNT_ID=act_123456789
# TikTok is optional until the provider is enabled. Leave these unset rather than using fake values.
# TIKTOK_APP_ID=replace-with-tiktok-app-id
# TIKTOK_APP_SECRET=replace-with-tiktok-app-secret
TIKTOK_SCOPES=
# Optional local/dev override. Production derives this from APP_URL.
# TIKTOK_REDIRECT_URI=http://localhost:3001/v1/integrations/tiktok/callback
TIKTOK_API_VERSION=v1.3
# TIKTOK_STATE_SECRET=replace-with-at-least-32-random-characters
# Optional override. Defaults to APP_URL + /v1/integrations/tiktok/webhooks.
# TIKTOK_WEBHOOK_URL=http://localhost:3001/v1/integrations/tiktok/webhooks
TIKTOK_WEBHOOK_MAX_AGE_SECONDS=300
