NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopify_intelligence
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=shopify-intelligence-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,read_orders
SHOPIFY_REDIRECT_URI=http://localhost:3001/v1/integrations/shopify/callback
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STATE_SECRET=replace-with-at-least-32-random-characters
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_SCOPES=ads_read,business_management,catalog_management
META_REDIRECT_URI=http://localhost:3001/v1/integrations/meta/callback
META_API_VERSION=v26.0
META_STATE_SECRET=replace-with-at-least-32-random-characters
